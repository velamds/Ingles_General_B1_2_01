t": 0}, {"id": 1, "_data": [{"content": "to play this game?", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "Could you show me how", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "id": 2}, {"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "time Frank is supposed to join us?", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "Do you know what", "type": "text"}]}, {"content": "secondary_8", "type": "objective"}], "id": 3}], "_data": [{"type": "instructions", "contents": [{"content": "Marla asks for clarification.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "post_instructions", "contents": [{"content": "\nInstructions: Move the words up or down <span class=\"sena-icon sena-icon-vertical-drag\"></span> to complete each sentence. \n", "type": "text"}]}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}]}], "id": 9, "stimuli_ids": []}, {"template_override": 1, "type": "RSLT", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 0}, {"id": 1, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}], "id": 10, "stimuli_ids": []}, {"template_override": 1, "type": "DWS", "questions": [{"responses": [{"id": 0, "_data": [{"content": "", "type": "text"}], "selected": 0, "correct": 1}], "_data": [{"type": "question", "contents": [{"content": "engenn7le01ob03re7pdf01.pdf", "type": "pdf"}]}], "id": 0}], "_data": [{"type": "instructions", "contents": [{"content": " Make a list of interesting team-building activities.", "type": "text"}]}, {"type": "group", "contents": [{"content": "Take Away", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "correct_feedback": "Correct!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "post_instructions", "contents": [{"content": "Instructions: Complete the following steps. Fill in the Self-Assessment.", "type": "text"}]}], "id": 11, "stimuli_ids": []}], "stimuli": [{"template_override": 1, "_data": [], "type": "welcome", "contents": [{}], "id": 0}, {"template_override": 1, "_data": [], "type": "audio", "title": "", "contents": [{"type": "slideshow", "value": {"audiosrc": "engenn7le01ob03re2aud01", "coverimg": "engenn7le01ob03re2img05.jpg", "images": [{"image": "engenn7le01ob03re2img05.jpg", "text": "", "id": 0, "time": "0"}, {"image": "engenn7le01ob03re2img05.jpg", "text": "<span class=\"strong\">Vanessa</span>:     Hey, Peter. How's work?<br/>\n<span class=\"strong\">Peter</span>:    Hey, Vanessa. Work's OK. I'm going to organize a few team-building activities  next week. We're going to book a table for six at your restaurant. Can you tell me which evening would suit you best?<br/>\n<span class=\"strong\">Vanessa</span>:    We're booked up every night this month, but I'll make special arrangements for you. <br/>\n<span class=\"strong\">Peter</span>:    Excellent. Thank you so much! We'll probably come next Tuesday, then.", "id": 1, "time": "100"}, {"image": "engenn7le01ob03re2img05.jpg", "text": "<span class=\"strong\">Vanessa</span>:    Next Tuesday sounds great. Do you know what you're going to do after dinner?<br/>\n<span class=\"strong\">Peter</span>:           I'm thinking of taking my colleagues to a karaoke bar. There's nothing like bonding over tone-deaf singing!<br/>\n<span class=\"strong\">Vanessa</span>:    Don't drink too much beer, though. You'll have a terrible hangover. Can you imagine going to work the day after?<br/>\n<span class=\"strong\">Peter</span>:         Don't worry. Most of my colleagues are teetotalers. They're into clean living, team sports and board games.", "id": 2, "time": "21700"}, {"image": "engenn7le01ob03re2img01.jpg", "text": "<span class=\"strong\">Vanessa</span>:     Sounds like fun.  <br/>\n<span class=\"strong\">Peter</span>:        It is, actually. We're going to start a trivia night group. We'll compete all around the city! <br/>\n<span class=\"strong\">Vanessa</span>:    Do you know how many teams there are in Cambridge? You're going to have tough competitors.<br/>\n<span class=\"strong\">Peter</span>:           We'll give them a run for their money!", "id": 3, "time": "45000"}]}}], "id": 1}], "type": "scholar", "id": 0, "_data": [{"type": "lab_options", "contents": [{"content": true, "type": "has_nav"}, {"content": true, "type": "has_exercise_controls"}]}]}], "_data": [{"type": "metadata", "contents": [{"content": "Hanging out With Friends", "type": "lesson_name"}, {"content": "A Table for Six", "type": "unit_name"}, {"content": 3, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 1, "type": "lesson"}, {"content": "B1.2", "type": "level"}]}, {"type": "achievment_test", "contents": [{"content": "false", "type": "test"}]}, {"type": "objectives", "contents": [{"content": " Exchange advice and suggestions in communicative situations.", "type": "primary"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology. ", "type": "secondary_1"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology. ", "type": "secondary_2"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology. ", "type": "secondary_3"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology. ", "type": "secondary_4"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology. ", "type": "secondary_5"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology. ", "type": "secondary_6"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology. ", "type": "secondary_7"}, {"content": " Identifies important and specific information and aspects of attitude and intention in conversations, texts or presentations about common technology. ", "type": "secondary_8"}]}, {"content": "engenn7le01ob03re1img01.jpg", "type": "background_image"}, {"type": "learning_points", "contents": [{"content": " Questions with Sentences / Asking for Clarification", "type": "heading"}, {"content": " You ask for clarification when you want more details of what the other person is talking about. ", "type": "describer"}, {"content": " You can use questions that contain sentences to ask for clarification. When a question has a sentence structure in it, it is called an <span class=\"strong\">embedded question</span>.", "type": "text"}, {"content": "You can use <span class=\"strong\">embedded questions</span> like <span class=\"italic\">Can you tell me ... ?</span> or <span class=\"italic\">Do you know if/which/what ... ?</span> to ask for clarification.", "type": "text"}, {"content": "An <span class=\"strong\">embedded question</span> builds on a simple question. <br/>Example: <br/><span class=\"italic\"><span class=\"strong\">Simple question</span>: What are you going to do after work today?<br/><span class=\"strong\">Embedded question</span>: Do you know what you're going to do after work today? ", "type": "text"}, {"content": "Embedded questions have the same word order as statements. Look at the chart for a further explanation:", "type": "text"}, {"content": "{\"rows\":7,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Main Question</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Embedded Question</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Do you know \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what you're going to do after dinner? \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Can you tell me \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"what the time is?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Could you tell me \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"which evening would suit you best? \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Do you know \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"which fitness club I should go to? \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Don't you think \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"it sounds a bit too intense? \\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "Can you tell me which evening would suit you best?", "type": "example"}, {"content": "Do you know how many teams there are in Cambridge?", "type": "example"}, {"content": "Do you know what you're going to do after dinner?", "type": "example"}]}, {"type": "learning_points", "contents": [{"content": " Talking About Future Actions", "type": "heading"}, {"content": " You can use two different tenses to talk about the future.", "type": "describer"}, {"content": "<ul><li>You use <span class=\"italic\">will</span> for predictions about actions or situations in the future. It can also be for situations you cannot control or decisions made at the moment of speaking.</li>  <li>You use <span class=\"italic\">going to</span> for intentions, plans or ambitions.</li></ul>", "type": "text"}, {"content": "{\"rows\":3,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Structure</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Example\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Will</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\"> You will have a terrible hangover tomorrow because you drank too much beer. </span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\"> Going to</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"italic\\\">We are going to book a table for eight at the restaurant.</span>\\\"}\"],\"styles\":\" instruction_table_background intro_table_border\"}", "type": "table"}, {"content": "I'm going to organize a few team-building activities  next week. ", "type": "example"}, {"content": "We'll probably come next Tuesday, then.", "type": "example"}, {"content": "Don't drink too much beer, though. You'll have a terrible hangover.", "type": "example"}, {"content": "We're going to start a trivia night group.", "type": "example"}, {"content": "We'll compete all around the city! ", "type": "example"}, {"content": "You're going to have tough competitors.", "type": "example"}, {"content": "We'll give them a run for their money!", "type": "example"}]}, {"type": "target_word", "contents": [{"content": "team-building", "type": "name"}, {"content": "a type of action designed to enhance social relations among colleagues", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: I'm going to organize a few team-building activities.", "type": "example"}, {"content": "engenn7le01ob03aud01", "type": "audio"}]}, {"type": "target_word_describer", "contents": [{"content": " These are words you hear in a conversation about social activities.", "type": "text"}]}, {"type": "target_word", "contents": [{"content": "karaoke", "type": "name"}, {"content": "an activity involving singing to a prerecorded audio while reading the lyrics on a screen", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm taking my colleagues to a karaoke bar after dinner.", "type": "example"}, {"content": "engenn7le01ob03aud02", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "tone-deaf", "type": "name"}, {"content": "unable to be in tune with the music", "type": "definition"}, {"content": "(adjective)", "type": "part_speech"}, {"content": "Example: There is nothing like bonding over tone-deaf singing!", "type": "example"}, {"content": "engenn7le01ob03aud03", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "hangover", "type": "name"}, {"content": "the negative effect of drinking too much alcohol", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Don't drink too much beer. You'll have a terrible hangover tomorrow.", "type": "example"}, {"content": "engenn7le01ob03aud04", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "teetotaler", "type": "name"}, {"content": "a person who does not drink alcohol", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: Most of my friends are teetotalers. They don't drink alcohol.", "type": "example"}, {"content": "engenn7le01ob03aud05", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "board game", "type": "name"}, {"content": "a game involving several players, usually played by moving pieces on a board", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: My colleagues like team sports and board games.", "type": "example"}, {"content": "engenn7le01ob03aud06", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "trivia night", "type": "name"}, {"content": "a social activity involving teams answering questions about popular culture ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: We're going to start a trivia night group.", "type": "example"}, {"content": "engenn7le01ob03aud07", "type": "audio"}]}, {"type": "target_word", "contents": [{"content": "to give them a run for their money", "type": "name"}, {"content": "to make other competitors fight hard for a victory", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: We'll give our competitors a run for their money!", "type": "example"}, {"content": "engenn7le01ob03aud08", "type": "audio"}]}, {"type": "takeaway_extension", "contents": [{"content": "Go online. Find information about team-building activities around the world.", "type": "text"}, {"content": "Write a list of 4 activities you found interesting or original.", "type": "text"}, {"content": "Briefly explain why you think they are good activities, and why you would like to try them with your friends.", "type": "text"}, {"content": "Use the chart below to take notes.", "type": "text"}, {"content": "Compare your list with your partner and ask questions about their activities.<br> <br><br> <br>", "type": "text"}, {"content": "{\"rows\":4,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Where\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"What\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" Would  you do it?\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" <br> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  <br> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  <br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  <br> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  <br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  <br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  <br> \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  <br>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"  <br>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}", "type": "table"}]}, {"type": "takeaway_assessment", "contents": [{"content": "I write about social activities.", "type": "text"}, {"content": "I talk about future actions.", "type": "text"}, {"content": "I ask for clarification.", "type": "text"}]}]}